#!/bin/sh
# Stop internal material and secrets before they are committed.
# CI runs scripts/check_public_repo.py too, but only after the push — by then it is already public.
# Enable once per clone:  git config core.hooksPath .githooks
# Do NOT bypass with --no-verify.
set -eu

python3 scripts/check_public_repo.py --staged

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact -v; then
    echo ""
    echo "❌ pre-commit blocked: secret detected in staged changes."
    echo "   Remove the secret, or (if a false positive) allowlist it in .gitleaks.toml."
    exit 1
  fi
else
  echo "⚠️  gitleaks not installed — secret scan skipped. Install: brew install gitleaks"
fi
